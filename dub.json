{
    "name": "dwin32gen",
    "description": "The D Windows SDK projections generator",
    "authors": [
        "Răzvan Ștefănescu",
        "Alexander Verbitsky"
    ],
    "license": "BSL-1.0",
    "subPackages": [
        {
            "name": "climetadata",
            "description": "CLI metadata (winmd) parser",
            "targetType": "staticLibrary",
            "targetName": "climetadata",
            "targetPath": "bin/$BUILD_TYPE",
            "sourcePaths": [
                "climetadata/source"
            ],
            "importPaths": [
                "climetadata/source"
            ]
        },
        {
            "name": "dwin32gen",
            "description": "The D Windows SDK projection generator",
            "targetName": "dwin32gen",
            "targetType": "executable",
            "targetPath": "bin/$BUILD_TYPE",
            "sourcePaths": [
                "dwin32gen/source"
            ],
            "dependencies": {
                "dwin32gen:climetadata": "*"
            }
        },
        {
            "name": "dwin32json",
            "description": "Dump CLI metadata to JSON",
            "targetName": "dwin32json",
            "targetType": "executable",
            "targetPath": "bin/$BUILD_TYPE",
            "sourcePaths": [
                "dwin32json/source"
            ],
            "dependencies": {
                "dwin32gen:climetadata": "*",
                "argsd": "~>1.2.0"
            }
        }
    ],
    "buildTypes": {
        "debug": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ]
        },
        "release": {
            "buildOptions": [
                "releaseMode",
                "inline",
                "optimize"
            ]
        }
    },
    "targetType": "none"
}